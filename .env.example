# ================= AQAOS 配置基线（T-E01-05）=================
# 分层：NODE_ENV = development | staging | production
# 用法：cp .env.example .env，按层填写；staging/prod 变量由部署环境注入。
#
# 密钥生成规范（生产必填，缺失则启动即拒绝）：
#   ENCRYPTION_KEY:     openssl rand -base64 32
#   JWT_SECRET:         openssl rand -base64 48
#   LITELLM_MASTER_KEY: openssl rand -hex 24
#   AQAOS_CI_WEBHOOK_SECRET: openssl rand -hex 24
# 真实密钥禁止入库（.gitignore 已排除 .env / .env.*）。

# --- 运行层 ---
NODE_ENV=development

# --- 平台核心（生产必填：ENCRYPTION_KEY / JWT_SECRET） ---
ENCRYPTION_KEY=
JWT_SECRET=

# --- 数据层（本地默认对应 docker-compose.dev.yml） ---
DATABASE_URL=postgres://aqaos:aqaos@localhost:5432/aqaos
# 迁移测试 scratch 库（npm run test:db 自动创建/销毁；不设则跳过 DB 测试）
AQAOS_TEST_DATABASE_URL=postgres://aqaos:aqaos@localhost:5432/aqaos_test
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233

# --- 对象存储（证据/截图/报告） ---
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_ACCESS_KEY=aqaos
OBJECT_STORE_SECRET_KEY=aqaos-secret
OBJECT_STORE_BUCKET=aqaos-artifacts

# --- 模型网关（SDD §6.5：Anthropic Messages 协议端点） ---
ANTHROPIC_BASE_URL=http://localhost:4000
ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=sk-aqaos-dev-master-key

# --- 直连降级路径（网关不可用时的告警降级，非首选） ---
OPENAI_API_KEY=

# --- 向量记忆（过渡期保留；T-E02-08 切换 pgvector 后移除） ---
QDRANT_URL=http://localhost:6333

# --- 工单集成（Jira / GitHub，可选） ---
JIRA_BASE_URL=
JIRA_PROJECT_KEY=QA
JIRA_EMAIL=
JIRA_API_TOKEN=
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# --- CI 事件与 Webhook（场景 G） ---
AQAOS_CI_WEBHOOK_SECRET=

# --- 性能预算基线（应用级可覆盖，T-E04-03） ---
QA_TTFB_BUDGET_MS=800
QA_PAYLOAD_BUDGET_KB=2048
QA_REQUEST_BUDGET=60

# --- Dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4317
