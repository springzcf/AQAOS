{
  "name": "aqaos",
  "version": "0.1.0",
  "private": true,
  "description": "AQAOS（Autonomous QA Operating System）— 多 Agent 自主 QA 平台，演进自 QA-Swarm。",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "workers/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "light-my-request": "6.1.0"
  },
  "scripts": {
    "build": "tsc -b",
    "build:dashboard": "npm run build --workspace @aqaos/dashboard",
    "typecheck": "tsc -b --force && tsc -p db/tsconfig.json",
    "dev": "tsx packages/cli/src/index.ts",
    "api": "tsx apps/api/src/server.ts",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:regression": "vitest run tests/regression",
    "test:e2e": "playwright test tests/e2e",
    "test:db": "AQAOS_TEST_DATABASE_URL=\"${AQAOS_TEST_DATABASE_URL:-postgres://aqaos:aqaos@localhost:5432/aqaos_test}\" vitest run tests/regression/db-migrations.spec.ts",
    "db:migrate": "tsx db/migrate.ts up",
    "db:rollback": "tsx db/migrate.ts down",
    "db:status": "tsx db/migrate.ts status",
    "db:reset": "tsx db/migrate.ts reset",
    "lint": "eslint .",
    "format": "prettier --write .",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "prepare": "husky"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.12.0",
    "js-yaml": "^4.1.0",
    "openai": "^4.76.0",
    "pg": "^8.13.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@playwright/test": "^1.49.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^2.1.8"
  }
}
